/results
/checkpoint
checkpoints
**/data/scannetpp/coverage
**/data/scannetpp/coverage/
wandb/
lightning_logs/
outputs/
demo_out/
*-[0-9]*.out
*.ckpt
*.pth
*.pt
*.safetensors

# Large docs
*.pptx


# Local training logs (scripts/train/*.sh)
logs/

# Local datasets and download tooling (see README "Data preparation")
/data/scannetpp/raw
/data/scannetpp/processed
/data/dtu
/data/renderpy
/data/scannetpp_download

# local tool settings
.claude/
